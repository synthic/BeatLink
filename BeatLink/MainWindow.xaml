<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="BeatLink.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:BeatLink"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="BeatLink">

  <Grid Background="{StaticResource RunnerRed}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="BeatLink" Background="White" Foreground="Black" Height="31">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="Assets/Eye.png" />
      </TitleBar.IconSource>
    </TitleBar>

    <Viewbox Grid.Row="1">
      <Grid Width="624" Height="440">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image Source="Assets/BeatLink.svg" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,82,0">
          <FontIcon x:Name="LogInIcon"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="32" Glyph="&#xE73E;" Foreground="White" Opacity="0"
                    Margin="0,0,0,9" Height="48"
                    AutomationProperties.Name="Logged in" />
          <FontIcon x:Name="ConnectIcon"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="24" Glyph="&#xE701;" Foreground="White" Opacity="0" Height="48"
                    AutomationProperties.Name="Connected to game" />
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
          <TextBox x:Name="ServerBox"
                   Header="Server" PlaceholderText="localhost"
                   Margin="0,0,0,9"
                   AutomationProperties.Name="Server host" />
          <Button x:Name="LogInButton" Content="LOG IN" Click="LogInButton_Click"
                  CornerRadius="9,0,9,0" Margin="0,0,0,9" Width="480" Height="48" />
          <Button x:Name="ConnectButton" Content="CONNECT" Click="ConnectButton_Click"
                  CornerRadius="0,0,0,0" Margin="0,0,0,9" Width="480" Height="48" />
          <Button x:Name="LogOutButton" Content="LOG OUT" Click="LogOutButton_Click"
                  CornerRadius="0,9,0,9" Width="480" Height="48" />
          <TextBlock x:Name="StatusText" Foreground="White" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     FontSize="16" Margin="0,12,0,0" Text="" />
        </StackPanel>

        <TextBlock Grid.Row="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="18" Margin="0,0,0,18">
          Please visit our website at <Hyperlink Foreground="White" NavigateUri="https://beatrevival.me">beatrevival.me</Hyperlink>
        </TextBlock>
      </Grid>
    </Viewbox>
  </Grid>
</Window>
